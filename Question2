#include <bits/stdc++.h> using namespace std;
int main() { 
int H, W;
cin >> H >> W;

vector<vector<string>>grid;
  for(int r=0; r<H; ++r){
     for(int c=0; c<W; ++c ){
       cin>>grid[r][c];
     }
  }

int sr = -1, sc = -1, gr = -1, gc = -1;
for (int r = 0; r < H; r++) {
    for (int c = 0; c < W; c++) {
        if (grid[r][c] == "S") { sr = r; sc = c; }
        if (grid[r][c] == "G") { gr = r; gc = c; }
    }
}

// dist[r][c] = minimum steps from S to (r,c), -1 means unvisited //
// H rows, W columns, all elements initialized to -1.  vector<vector<int>> dist(H, vector<int>(W, -1));//
//💡To mark each stepped cell, we have to create a NEW vector<vector> grid//

vector<vector<int>> dist(H, vector<int>(W, -1));
queue<pair<int,int>> q;

//pair<> はmapと似ている. .first, ,secondを使う
dist[sr][sc] = 0;
q.push({sr, sc});

int dr[4] = {1, -1, 0, 0};
int dc[4] = {0, 0, 1, -1};

while (!q.empty()) {
    auto [r, c] = q.front();
    q.pop();

    for (int k = 0; k < 4; k++) {
        int nr = r + dr[k];
        int nc = c + dc[k];

        if (nr < 0 || nr >= H || nc < 0 || nc >= W) continue; // outside
        if (grid[nr][nc] == '#') continue;                    // wall (continue: 現在実行中のループ反復を途中で終了し、次の反復へ制御を移します。)
        if (dist[nr][nc] != -1) continue;                     // already visited

        dist[nr][nc] = dist[r][c] + 1;
        q.push({nr, nc});
    }
}

cout << dist[gr][gc] << "\n"; // -1 if unreachable
return 0;

}
Key idea BFS is different from DFS in a way that closest vertices are visited before others. We mainly traverse vertices level by level In short, marking {0,1,2,...} visited elements and adding to queue, then pop the queu in order.
function 幅優先探索(v) Q ← empty Queue v: vector of managing if visited v: visited v is added to Q while(Q is not empty) do v is taken from Q v is processed for each i (v[i]) do if i is not visited then i is marked as visited i is added to Q
//2️⃣ Direction arrays (this is just a trick)
k	dr[k]	dc[k]	move
0	+1	0	down
1	−1	0	up
2	0	+1	right
3	0	−1	left
So when we loop k = 0..3, we are trying: down, up, right, left


continueとbreakが異なる点は、breakが繰り返し処理を強制終了するのに対して、continueは以降の処理を中断し、繰り返し処理の先頭に戻ることです

