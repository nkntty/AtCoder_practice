#include<iostream>
#include<vector>
using namespace std;

int main(){
  int N;
  cin>>N;
  vector<int>a(N);
  for(int i=0; i<N; ++i){
    cin>>a[i];
  }
  vector<int>S(N+1, 0);
  for(int i=0; i<N; ++i){
    S[i+1]=S[i]+a[i];
  }
  int length;
  cin>>length;
  int Max=INT_MIN;
  for(int left=0; left<N-length+1; left++){
      int right=length+left-1;
      int ans=S[right+1]-S[left];
      cout<<ans<<endl;
      Max=max(Max,ans);
  }

cout<<"Maximum sum of subsequence is:"<<Max<<endl;
