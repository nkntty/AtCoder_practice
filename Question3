//Q1//
#include <bits/stdc++.h>
using namespace std;

long long knapSack(int W, const vector<int>& weights, const vector<int>& values) {
    int n = (int)weights.size();
    vector<vector<long long>> dp(n + 1, vector<long long>(W + 1, 0));

    // dp[i][w] = best value using first i items (items 0..i-1) with capacity w
    for (int i = 1; i <= n; i++) {
        int wt = weights[i - 1];
        int val = values[i - 1];
        for (int w = 0; w <= W; w++) {
            // exclude item i-1
            dp[i][w] = dp[i - 1][w];

            // include item i-1 if it fits
            if (w >= wt) {
                dp[i][w] = max(dp[i][w], dp[i - 1][w - wt] + val);
            }
        }
    }
    return dp[n][W];
}


int main(){
vector<int>values;
vector<int weights>;
int input_value,input_weight;
int N,W;

cin>>N>>W;
for(int i=0; i<=N){
  cin>>input_value>>input_weight
  values.push_back(input_value);
  weights.push_back(input_weight);
}
cout<<knapSack(W,weights,values, N)<<endl

return 0;
}





//Recall the meaning of dp[i][j] (this matters)

dp[i][j] = the maximum value you can get
using activities 1..i
with at most j remaining time

So:

i → which activities you’re allowed to consider

j → how much time you have available   //






