//Q1//
#include<iostream>
#include<vector>
#include<algorithm>
using namespace std;

int knapSack(int W, const vector<int>& weights, const vector<int>& values, int n){

   vector<vector<int>>dp(n+1, vector<int>(W+1, 0));
for(int i=1; i<=n; ++i){
  for(int w=1; w<=W; ++w){
    if(w >= wights[i-1]){
       int includeItem=dp[i-1][w-wights[i-1]] + values[i-1];
       int excludeItem=dp[i-1][w];

       dp[i][w]=max(includeItem, excludeItem);
    }else
    dp[i][w]=dp[i-1][w];
  }

}
  return dp[n][w];
}

int main(){
vector<int>values;
vector<int weights>;
int input_value,input_weight;
int N,W;

cin>>N>>W;
for(int i=0; i<=N){
  cin>>input_value>>input_weight
  values.push_back(input_value);
  weights.push_back(input_weight);
}
cout<<knapSack(W,weights,values, N)<<endl

return 0;
}

