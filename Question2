#include<iostream>
#include <climits>
using namespace std;
int main() { ios::sync_with_stdio(false); cin.tie(nullptr);
int N;
long long K;
cin >> N >> K;

vector<long long> A(N);
for (int i = 0; i < N; i++) cin >> A[i];

long long sum = 0;
int ans = INT_MAX;
int r = 0;

for (int l = 0; l < N; l++) {
    // Expand r until sum >= K or r reaches N
   // for each l roop, the r inside the while roop is saved, r being fowarded
    while (r < N && sum < K) {
        sum += A[r];
        r++;
    }

    // If we reached sum >= K, update answer
    if (sum >= K) {
        ans = min(ans, r - l);       //まずjだけを動かして条件を満たした時のカウントを先に行う、その後iを動かして最適化をする
    }

    // Move left forward (remove A[l] from window)
    sum -= A[l];
}

if (ans == INT_MAX) cout << -1 << "\n";
else cout << ans << "\n";

}
The key is: the inner loop does not restart from scratch each time. =>Thats why its better than O(N^2) Crucial difference
r is declared outside the for
r never goes backward
r only increases

